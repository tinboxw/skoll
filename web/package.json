{
	"name": "skoll-admin-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check:i18n": "node scripts/h4-locale-baseline-check.mjs",
		"check:a11y": "node scripts/h4-accessibility-check.mjs",
		"check:large-list": "node scripts/h5-large-list-check.mjs",
		"check:theme": "node scripts/pr4-theme-token-check.mjs",
		"check:bundle": "node scripts/pr4-bundle-budget.mjs",
		"check:plugin-center:bundle": "node scripts/bf3-plugin-control-center-budget.mjs",
		"test:components": "vitest run && npm --prefix ../packages/skoll-document-ui test",
		"test:documents": "npm --prefix ../packages/skoll-document-ui test",
		"test:documents:browser": "playwright test --config playwright.config.ts business-document-kit.spec.ts",
		"test:plugin-center": "playwright test --config playwright.config.ts plugin-control-center.spec.ts",
		"test:plugin-center:visual": "playwright test --config playwright.config.ts plugin-control-center-visual.spec.ts",
		"test:plugin-center:visual:update": "playwright test --config playwright.config.ts plugin-control-center-visual.spec.ts --update-snapshots",
		"test:plugin-center:performance": "playwright test --config playwright.config.ts plugin-control-center-performance.spec.ts",
		"test:states": "playwright test --config playwright.config.ts state-matrix.spec.ts",
		"test:visual": "npm run test:plugin-center:visual",
		"test:visual:update": "npm run test:plugin-center:visual:update",
		"test:performance": "npm run test:plugin-center:performance",
		"typecheck": "npm run check:i18n && npm run check:a11y && npm run check:large-list && npm run check:theme && vue-tsc --noEmit && npm --prefix ../packages/skoll-document-ui run typecheck",
		"preview": "vite preview",
		"smoke:health": "node scripts/health-smoke.mjs",
		"smoke:auth": "node scripts/auth-plugin-smoke.mjs",
		"smoke:plugins": "node scripts/plugin-sync-smoke.mjs",
		"smoke:auth-actor": "node scripts/auth-actor-fallback-smoke.mjs",
		"smoke:m1-permissions": "node scripts/m1-permission-menu-smoke.mjs",
		"smoke:browser:minimum": "node scripts/fe5-browser-smoke-minimum.mjs",
		"smoke:all": "node scripts/run-smoke-suite.mjs"
	},
	"dependencies": {
		"element-plus": "^2.14.1",
		"lucide-vue-next": "^1.0.0",
		"pinia": "^2.1.7",
		"vue": "^3.4.38",
		"vue-router": "^4.4.3",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vue/test-utils": "^2.4.6",
		"jsdom": "^25.0.1",
		"sass": "^1.99.0",
		"typescript": "^5.9.3",
		"unplugin-auto-import": "^0.18.6",
		"unplugin-vue-components": "^0.27.5",
		"vite": "^5.4.21",
		"vitest": "^2.1.9",
		"vue-tsc": "^3.3.4"
	}
}
