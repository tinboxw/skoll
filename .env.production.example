# Skoll production baseline example
# Copy this file to your deployment secret manager or runtime env file.

# Core runtime
SKOLL_SHUTDOWN_TIMEOUT=12s
SKOLL_DRAIN_TIME=3s

# go-admin runtime mode
SKOLL_GO_ADMIN_ENABLED=true
SKOLL_GO_ADMIN_MODE=prod

# Admin auth baseline (production recommended)
SKOLL_ADMIN_AUTH_MODE=hmac-sha256
SKOLL_ADMIN_AUTH_HMAC_SECRET=REPLACE_WITH_STRONG_SECRET
SKOLL_ADMIN_AUTH_ALLOW_STATIC_TOKEN_IN_PROD=false

# Replay defense: shared nonce store for multi-instance deployments
SKOLL_ADMIN_AUTH_NONCE_STORE=redis
SKOLL_ADMIN_AUTH_NONCE_REDIS_ADDR=127.0.0.1:6379
SKOLL_ADMIN_AUTH_NONCE_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
SKOLL_ADMIN_AUTH_NONCE_REDIS_DB=0
SKOLL_ADMIN_AUTH_NONCE_REDIS_KEY_PREFIX=skoll:adminauth:nonce:
