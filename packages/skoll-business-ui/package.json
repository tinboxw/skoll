{
	"name": "@skoll/business-ui",
	"version": "1.0.0",
	"description": "Element Plus business workspace composition primitives for Skoll plugins.",
	"type": "module",
	"files": ["dist"],
	"sideEffects": ["*.css"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style.css": "./dist/style.css"
	},
	"scripts": {
		"build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
		"test": "vitest run",
		"typecheck": "vue-tsc -p tsconfig.build.json --noEmit"
	},
	"peerDependencies": {
		"@skoll/document-ui": "^0.1.0",
		"element-plus": "^2.9.0",
		"lucide-vue-next": ">=0.468.0 <2",
		"vue": "^3.4.0"
	},
	"devDependencies": {
		"@skoll/document-ui": "file:../skoll-document-ui",
		"@vitejs/plugin-vue": "5.2.4",
		"@vue/test-utils": "2.4.6",
		"element-plus": "2.14.1",
		"jsdom": "25.0.1",
		"lucide-vue-next": "1.0.0",
		"typescript": "5.9.3",
		"unplugin-vue-components": "0.27.5",
		"vite": "5.4.21",
		"vitest": "2.1.9",
		"vue": "3.5.34",
		"vue-tsc": "3.3.4"
	}
}
