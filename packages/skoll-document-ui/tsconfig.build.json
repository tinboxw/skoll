{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "preserve",
		"skipLibCheck": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"outDir": "dist"
	},
	"include": ["src/**/*.ts", "src/**/*.vue"],
	"exclude": ["src/**/*.spec.ts"]
}
