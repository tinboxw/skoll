{
	"name": "@skoll/plugin-test",
	"version": "1.0.0",
	"description": "Current-contract concurrency, UI-state, visual, and performance test drivers for Skoll plugins.",
	"type": "module",
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
