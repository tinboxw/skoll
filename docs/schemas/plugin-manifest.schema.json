{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skoll.local/schemas/plugin-manifest.schema.json",
  "title": "Skoll Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "compatibility_skoll": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "ui_mode": {
      "type": "string",
      "enum": ["backend_only", "frontend_only", "monolith", "separated"]
    },
    "level": {
      "type": "string",
      "enum": ["system", "app"]
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$"
    },
    "mount_policy": {
      "type": "string",
      "enum": ["admin", "user", "mixed"]
    },
    "ui_nav_position": {
      "type": "string",
      "enum": ["none", "sidebar", "top_tab"]
    },
    "ui_open_mode": {
      "type": "string",
      "enum": ["integrated", "standalone"]
    },
    "ui_tab_mode": {
      "type": "string",
      "enum": ["optional", "fixed", "disabled"]
    },
    "i18n_locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      }
    },
    "ui_menu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "label_zh_cn": { "type": "string", "minLength": 1 },
        "label_en_us": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "icon": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" },
        "required_roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_permissions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "title_zh_cn": { "type": "string" },
        "title_en_us": { "type": "string" },
        "description": { "type": "string" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "label_zh_cn": { "type": "string" },
              "label_en_us": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["string", "textarea", "number", "boolean", "select"]
              },
              "required": { "type": "boolean" },
              "default": { "type": ["string", "number", "boolean"] },
              "placeholder": { "type": "string" },
              "help": { "type": "string" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "min_length": { "type": "integer", "minimum": 0 },
              "max_length": { "type": "integer", "minimum": 0 },
              "pattern": { "type": "string" },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value"],
                  "properties": {
                    "value": { "type": ["string", "number", "boolean"] },
                    "label": { "type": "string" },
                    "label_zh_cn": { "type": "string" },
                    "label_en_us": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "frontend_entry": {
      "type": "string"
    },
    "service_base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "service_health_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "migration_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["api_version"]
      },
      "then": {
        "required": ["compatibility_skoll"]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "ui_mode": { "const": "backend_only" }
          }
        }
      },
      "then": {
        "required": ["i18n_locales"]
      }
    },
    {
      "if": {
        "properties": {
          "ui_open_mode": { "const": "standalone" }
        }
      },
      "then": {
        "properties": {
          "ui_nav_position": { "const": "none" },
          "ui_tab_mode": { "const": "disabled" }
        }
      }
    }
  ]
}
