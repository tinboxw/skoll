{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skoll.local/schemas/plugin-manifest.schema.json",
  "title": "Skoll Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "compatibility_skoll": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "ui_mode": {
      "type": "string",
      "enum": ["backend_only", "frontend_only", "monolith", "separated"]
    },
    "level": {
      "type": "string",
      "enum": ["system", "app"]
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$"
    },
    "mount_policy": {
      "type": "string",
      "enum": ["admin", "user", "mixed"]
    },
    "frontend_entry": {
      "type": "string"
    },
    "service_base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "service_health_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "migration_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["api_version"]
      },
      "then": {
        "required": ["compatibility_skoll"]
      }
    }
  ]
}
